# ─────────────────────────────────────────────────────────────
# VANTA — environment variables
# Every block is optional. Without them the project runs in demo mode:
# embedded PGlite database, local auth, local uploads, simulated checkout.
# Copy to .env.local and fill in what you want to enable.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for Stripe return URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign demo-mode session cookies. Use 32+ random chars in production:
#   openssl rand -base64 32
AUTH_SECRET=

# ── Database ────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (Transaction pooler, port 6543)
# Leave empty to use the embedded demo database in ./.data/pglite
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# ── Supabase Auth & Storage ─────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to upload product images to Storage. NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Stripe (TEST MODE ONLY) ─────────────────────────────────
# Only sk_test_ keys are accepted; live keys are ignored on purpose.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the dashboard endpoint
STRIPE_WEBHOOK_SECRET=
